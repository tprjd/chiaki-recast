+                                qInfo() << "TEMP mapped plane" << i << "size" << plane.texture->params.w << plane.texture->params.h
+                                    << "components" << plane.components << "mapping" << plane.component_mapping[0]
+                                    << plane.component_mapping[1] << plane.component_mapping[2] << plane.component_mapping[3];
+                            }
+                        }
+                        if (elapsed >= 750 && q->frame_mix.num_frames) {
+                            using ReadTexture = void (*)(GLuint, GLint, GLint, GLint, GLint, GLsizei, GLsizei, GLsizei,
+                                GLenum, GLenum, GLsizei, void *);
+                            const auto readTexture = reinterpret_cast<ReadTexture>(context->getProcAddress("glGetTextureSubImage"));
