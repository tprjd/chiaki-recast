+                            if (readTexture) {
+                                GLint packBuffer = 0, packValues[6] = {};
+                                const GLenum packNames[] = {GL_PACK_ALIGNMENT, GL_PACK_ROW_LENGTH, GL_PACK_IMAGE_HEIGHT,
