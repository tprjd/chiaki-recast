+QVariantMap SetupBridge::wakeConsole(const QString &key)
+{
+    int index;
+    QString nickname;
+    if (state.value("connectionBusy").toBool() || !resolveConsole(key, index, nickname)) return {{"accepted", false}};
+    return {{"accepted", backend->wakeUpHost(index, nickname)}};
