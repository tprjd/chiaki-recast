{
    "name": "chiaki-ng",
    "buildsystem": "cmake-ninja",
    "builddir": true,
    "build-options": {
        "prepend-path": "/app/node/bin",
        "env": {
            "npm_config_offline": "true",
            "npm_config_cache": "/run/build/chiaki-ng/flatpak-node/npm-cache"
        }
    },
    "config-opts": ["-DCMAKE_POLICY_VERSION_MINIMUM=3.5", "-DCHIAKI_ENABLE_TESTS=OFF", "-DCHIAKI_ENABLE_SPEEX=ON", "-DCHIAKI_ENABLE_RUDP=ON"],
    "sources": [
        {
            "type": "dir",
            "path": "../..",
            "skip": [".git", ".scratch", "build*", "appimage", "gui/web/node_modules", "gui/web/dist"]
        },
        "frontend-sources.json"
    ],
    "post-install": [
        "install -Dm755 ../scripts/psn-account-id.py /app/bin/psn-account-id",
        "if test $(uname -m) = x86_64; then install -Dm644 ../scripts/vulkan-gamescope-layers/VkLayer_FROG_gamescope_wsi.x86_64.json /app/share/vulkan/implicit_layer.d/VkLayer_FROG_gamescope_wsi.x86_64.json; fi",
        "install -Dm644 ../COPYING /app/share/licenses/chiaki-ng/COPYING",
        "install -Dm755 ../scripts/check-linux-package.sh /app/bin/check-chiaki-package"
    ]
}
